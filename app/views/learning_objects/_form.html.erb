<%= form_with(model: learning_object, class: "mb-3") do |f| %>
  <% if learning_object.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(learning_object.errors.count, "error") %> prevented this learning object from being saved:</h5>
      <ul class="mb-0">
        <% learning_object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :site_id, "Site", class: "form-label" %>
    <%= f.collection_select :site_id, Site.all, :id, :name, { prompt: "Select a site" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :lo, "Learning Object File", class: "form-label" %>
    <%= f.file_field :lo, class: "form-control" %>
    <% if learning_object.lo.present? %>
      <small class="text-muted">Current file: <%= File.basename(learning_object.lo.url) %></small>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :info_xml, "Info XML (optional)", class: "form-label" %>
    <%= f.file_field :info_xml, class: "form-control" %>
    <% if learning_object.info_xml.present? %>
      <small class="text-muted">Current file: <%= File.basename(learning_object.info_xml.url) %></small>
    <% end %>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
