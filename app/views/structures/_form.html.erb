<%= form_with(model: structure, class: "mb-3") do |f| %>
  <% if structure.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(structure.errors.count, "error") %> prevented this structure from being saved:</h5>
      <ul class="mb-0">
        <% structure.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :course_id, "Course UUID (leave blank to create new)", class: "form-label" %>
    <%= f.text_field :course_id, class: "form-control", placeholder: "e.g. 3f2a1b4c-5d6e-7f8a-9b0c-1d2e3f4a5b6c" %>
  </div>

  <div class="mb-3">
    <%= f.label :site_id, "Site", class: "form-label" %>
    <%= f.collection_select :site_id, Site.all, :id, :name, { prompt: "Select a site" }, { class: "form-select" } %>
  </div>

  <div class="mb-3">
    <%= f.label :structure_xml, "Structure XML File", class: "form-label" %>
    <%= f.file_field :structure_xml, class: "form-control", accept: ".xml" %>
    <% if structure.structure_xml.present? %>
      <small class="text-muted">Current file: <%= File.basename(structure.structure_xml.url) %></small>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :cover_image_url, "Cover Image URL", class: "form-label" %>
    <%= f.text_field :cover_image_url, class: "form-control", value: "https://www.avallain.com/_next/image?url=https%3A%2F%2Fassets.avallain.com%2Fwp-content%2Fuploads%2F2024%2F05%2Fmagnet-logo-big.png&w=1080&q=100" %>
    <small class="text-muted">Required when creating a new course. URL to a cover image the importer will download.</small>
  </div>

  <%= f.submit class: "btn btn-primary" %>
<% end %>
