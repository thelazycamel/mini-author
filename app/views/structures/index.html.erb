<h1>Structures</h1>

<%= link_to "New Structure", new_structure_path, class: "btn btn-primary mb-3" %>

<table class="table table-striped">
  <thead>
    <tr>
      <th>Name</th>
      <th>Site</th>
      <th>Course ID</th>
      <th>Upload Response</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @structures.each do |structure| %>
      <tr>
        <td><%= structure.name %></td>
        <td><%= structure.site.name %></td>
        <td><code><%= structure.course_id %></code></td>
        <td><%= structure.upload_response %></td>
        <td>
          <%= link_to "Edit", edit_structure_path(structure), class: "btn btn-sm btn-outline-primary" %>
          <%= button_to "Delete", structure_path(structure), method: :delete, class: "btn btn-sm btn-outline-danger", data: { turbo_confirm: "Are you sure?" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
